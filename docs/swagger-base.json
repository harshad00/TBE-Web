{
  "openapi": "3.0.0",
  "info": {
    "title": "The Boring Education API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/jobs": {
      "post": {
        "summary": "Add a new job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique identifier for the job"
                  },
                  "company": {
                    "type": "string",
                    "description": "Company offering the job"
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required skills for the job"
                  },
                  "role": {
                    "type": "string",
                    "description": "Job role"
                  },
                  "location": {
                    "type": "string",
                    "description": "Job location"
                  },
                  "jobUrl": {
                    "type": "string",
                    "description": "URL to the job posting"
                  },
                  "platform": {
                    "type": "string",
                    "description": "Platform where the job is listed"
                  },
                  "experience": {
                    "type": "string",
                    "description": "Required experience for the job"
                  },
                  "salary": {
                    "type": "string",
                    "description": "Salary offered for the job"
                  },
                  "isInternship": {
                    "type": "boolean",
                    "description": "Indicates if the job is an internship"
                  },
                  "stipend": {
                    "type": "string",
                    "description": "Stipend for the internship if applicable"
                  }
                },
                "required": [
                  "id",
                  "company",
                  "role",
                  "location",
                  "jobUrl",
                  "platform",
                  "skills"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required job details or job already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to add job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Fetch all jobs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skills",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error fetching jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}